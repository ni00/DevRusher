{
  "name": "devrusher",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "preinstall": "node scripts/require-node-26.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "perf:check": "node scripts/check-performance.mjs",
    "check": "prettier --check . && eslint . --max-warnings=0 && tsc --noEmit && node --test tests/*.test.mjs && node scripts/content/cli.mjs check",
    "fix": "eslint . --fix && prettier --write .",
    "content": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/content/cli.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.27",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "ai": "7.0.58",
    "clsx": "2.1.1",
    "lucide-react": "1.30.0",
    "microlighter": "^2.1.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.20.0"
}
